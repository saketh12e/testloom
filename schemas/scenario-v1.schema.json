{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "JourneyProof Scenario v1",
  "description": "Ordered observations plus explicitly authored test requirements.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "startUrl",
    "createdAt",
    "events",
    "assertions",
    "warnings",
    "network"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "startUrl": {
      "type": "string",
      "pattern": "^https?://"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "events": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "$ref": "#/$defs/event"
      }
    },
    "assertions": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "$ref": "#/$defs/assertion"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "network": {
      "type": "array",
      "maxItems": 2000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "method",
          "url",
          "status"
        ],
        "properties": {
          "method": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "minimum": 0,
            "maximum": 599
          }
        }
      }
    }
  },
  "$defs": {
    "locator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strategy",
        "value"
      ],
      "properties": {
        "strategy": {
          "enum": [
            "testId",
            "role",
            "label",
            "placeholder",
            "text",
            "css"
          ]
        },
        "value": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string"
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sequence",
        "timestamp",
        "action",
        "url",
        "pageId",
        "label",
        "locators"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "action": {
          "enum": [
            "navigate",
            "click",
            "fill",
            "check",
            "uncheck",
            "select",
            "press",
            "popup",
            "note"
          ]
        },
        "url": {
          "type": "string"
        },
        "pageId": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "locators": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/locator"
          }
        },
        "value": {
          "type": "string"
        },
        "redacted": {
          "type": "boolean"
        },
        "screenshot": {
          "type": "string"
        },
        "frameSelectors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "description",
        "kind",
        "expected",
        "source"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "text",
            "visible",
            "url",
            "custom"
          ]
        },
        "locator": {
          "$ref": "#/$defs/locator"
        },
        "expected": {
          "type": "string"
        },
        "source": {
          "const": "user"
        }
      }
    }
  }
}
